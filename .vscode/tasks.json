{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build and run C++",
            "type": "shell",
            "command": "g++",
            "args": [
                "-mconsole",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Generated task for building and running C++ files"
        }
    ]
}
